# Comma-separated Vercel URL(s), plus localhost for local development.
FRONTEND_ORIGINS=http://localhost:3000,https://your-vercel-domain.vercel.app
# Add Supabase values in Render Environment settings before enabling persistence.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Configure a transactional email provider before marking deliveries fulfilled.
DELIVERY_EMAIL_PROVIDER=
DELIVERY_EMAIL_API_KEY=
STARTER_KIT_DOWNLOAD_URL=
COMMUNITY_INVITE_URL=