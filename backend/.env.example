# ============================================================================
# BACKEND ENVIRONMENT VARIABLES (.env)
# ============================================================================
# Copy this file to .env and fill in the actual values
# This file is used by the FastAPI server (main.py)

# ============================================================================
# REQUIRED - CORS CONFIGURATION
# ============================================================================
# Comma-separated list of frontend origin URLs allowed to make requests
# This prevents unauthorized cross-origin requests
# Include both development (localhost:3000) and production URLs

# Development
FRONTEND_ORIGINS=http://localhost:3000

# Production - add your Vercel frontend domain
# FRONTEND_ORIGINS=http://localhost:3000,https://your-vercel-domain.vercel.app

# ============================================================================
# OPTIONAL - ENROLLMENT DELIVERY & PERSISTENCE
# ============================================================================
# Store enrollment records persistently (currently in-memory without these)

# Supabase PostgreSQL database connection
# Required for storing enrollment records beyond memory
# Get these from your Supabase project dashboard
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ============================================================================
# OPTIONAL - EMAIL DELIVERY NOTIFICATIONS
# ============================================================================
# Send enrollment confirmation/receipt emails after delivery
# Configure your transactional email provider before marking deliveries as fulfilled

# Email provider: sendgrid, postmark, resend, or mailgun
DELIVERY_EMAIL_PROVIDER=

# API key for your chosen email provider
DELIVERY_EMAIL_API_KEY=

# ============================================================================
# OPTIONAL - ONBOARDING & COMMUNITY ACCESS
# ============================================================================
# Links sent to newly enrolled students in confirmation emails

# Download link for the Starter Kit (PDF, templates, worksheets)
STARTER_KIT_DOWNLOAD_URL=

# Discord or community invite link for new enrollees
COMMUNITY_INVITE_URL=

# ============================================================================
# NOTES FOR DEPLOYMENT
# ============================================================================
# 1. FRONTEND_ORIGINS must match your deployed frontend URL exactly
# 2. Never commit the actual .env file to version control (it's in .gitignore)
# 3. For production on Render/Railway/Vercel, set these in platform environment settings
# 4. Keep FRONTEND_ORIGINS restrictive - only add domains you control
# 5. All SUPABASE and EMAIL variables are optional for MVP (data stored in memory)
# 6. The /enrollments/deliver endpoint requires the Idempotency-Key header
# 7. Health check: GET / returns online status, GET /health returns phase info